# PostgreSQL connection string. Supabase is recommended for hosted pgvector.
DATABASE_URL=postgresql://documind:local-dev-only-change-this@localhost:5432/documind
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# For OpenAI instead, set AI_PROVIDER=openai and add OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
OCR_LANGUAGE=eng
# Use DATABASE_SSL=disable for local Docker PostgreSQL only.
DATABASE_SSL=disable
PG_POOL_SIZE=10
PORT=3000
